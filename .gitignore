# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# UI Toolkit auto generated files
/UIElementsSchema/

# Auto-generated cache in Assets folder
/[Aa]ssets/[Ss]ceneDependencyCache*


using System;
using System.Collections.Generic;

namespace WWBS
{
    class Weapon
    {
        public string name;
        public int damage;
        public int headshotdamage;
        public decimal range;
        public decimal stunduration;

        public Weapon(
            string name,
            int damage,
            int headshotdamage,
            decimal range,
            decimal stunduration)
        {
            this.name = name;
            this.damage = damage;
            this.headshotdamage = headshotdamage;
            this.range = range;
            this.stunduration = stunduration;
        }
    }

    class Item
    {
        public string name;
        public int healing;

        public Item(string name, int healing)
        {
            this.name = name;
            this.healing = healing;
        }
    }

    class Injury
    {
        public string bodypart;
        public string description;
        public int severity;

        public Injury(
            string bodypart,
            string description,
            int severity)
        {
            this.bodypart = bodypart;
            this.description = description;
            this.severity = severity;
        }
    }

    class Unit
    {
        public string name = string.Empty;
        public int momentum;
        public int velocity;

        public bool isalive = true;
        public bool isconscious = true;
        public Weapon? primary;
        public Weapon? secondary;

        public List<Item> inventory = new List<Item>();
        public List<Injury> injuries = new List<Injury>();

        public void AttackPrimary(Unit target)
        {
            if (primary == null)
            {
                Console.WriteLine(name + " has no primary weapon.");
                return;
            }

            if (isalive == false)
            {
                Console.WriteLine(target.name + " is already defeated.");
                return;
            }

            target.TakeDamage(primary.damage);

            Console.WriteLine(
                name + " attacks " + target.name +
                " with " + primary.name +
                " for " + primary.damage + " damage."
            );
        }

        public void AttackSecondary(Unit target)
        {
            if (secondary == null)
            {
                Console.WriteLine(name + " has no secondary weapon.");
                return;
            }

            if (isalive == false)
            {
                Console.WriteLine(target.name + " is already defeated.");
                return;
            }

            target.TakeDamage(secondary.damage);

            Console.WriteLine(
                name + " attacks " + target.name +
                " with " + secondary.name +
                " for " + secondary.damage + " damage."
            );
        }

        public void HeadshotPrimary(Unit target)
        {
            if (primary == null)
            {
                Console.WriteLine(name + " has no primary weapon.");
                return;
            }

            if (isalive == false)
            {
                Console.WriteLine(target.name + " is already defeated.");
                return;
            }

            target.TakeDamage(primary.headshotdamage);

            Console.WriteLine(
                name + " headshots " + target.name +
                " with " + primary.name +
                " for " + primary.headshotdamage + " damage."
            );
        }

        public void TakeDamage(int damage)
        {
            if (damage <= 0)
            {
                Console.WriteLine("Damage must be greater than zero.");
                return;
            }

            if (isalive == false)
            {
                Console.WriteLine(name + " is already defeated.");
                return;
            }

            if (isalive == false)
            {
                Console.WriteLine(name + " has been defeated.");
            }
        }

        public void Heal(int amount)
        {
            if (amount <= 0)
            {
                Console.WriteLine("Healing must be greater than zero.");
                return;
            }

            if (isalive == false)
            {
                Console.WriteLine(name + " cannot heal after being defeated.");
                return;
            } 
          }

        public void ReceiveInjury(Injury injury)
        {
            injuries.Add(injury);

            Console.WriteLine(
                name + " suffers an injury to the " +
                injury.bodypart + ": " +
                injury.description +
                " (Severity: " + injury.severity + ")"
            );
        }

        public void AddItem(Item item)
        {
            inventory.Add(item);

            Console.WriteLine(name + " picked up " + item.name + ".");
        }

        public void UseItem(int itemNumber)
        {
            if (itemNumber < 0 || itemNumber >= inventory.Count)
            {
                Console.WriteLine(name + " does not have that item.");
                return;
            }

            Item item = inventory[itemNumber];
            
            if (isalive == false)
            {
                Console.WriteLine(name + " cannot use items after being defeated.");
                return;
            }

            Console.WriteLine(name + " uses " + item.name + ".");

            inventory.RemoveAt(itemNumber);
        }

        public void ShowInventory()
        {
            Console.WriteLine(name + "'s inventory:");

            if (inventory.Count == 0)
            {
                Console.WriteLine("- Empty");
                return;
            }

            for (int i = 0; i < inventory.Count; i++)
            {
                Console.WriteLine(
                    i + ": " + inventory[i].name +
                    " (heals " + inventory[i].healing + ")"
                );
            }
        }

        public void FriendYeet(Unit target)
        {
            target.velocity += 20;

            Console.WriteLine(
                name + " yeets " + target.name + ". " +
                target.name + "'s velocity is now " +
                target.velocity + "."
            );
        }
    }

    // =========================
    // CLASSES
    // =========================

    class ManAtArms : Unit { }
    class Archer : Unit { }
    class Gunslinger : Unit { }
    class Mage : Unit { }
    class Barbarian : Unit { }
    class Bard : Unit { }
    class Builder : Unit { }
    class Medic : Unit { }
    class Priest : Unit { }
    class Craftsman : Unit { }

    // =========================
    // PROGRAM
    // =========================

    class Program
    {
        static void Main()
        {
            ManAtArms manAtArms = new ManAtArms();
            manAtArms.name = "Man-at-Arms";
            manAtArms.momentum = 0;
            manAtArms.velocity = 5;
            manAtArms.primary = new Weapon("Spear", 30, 150, 3m, 0.5m);
            manAtArms.secondary = new Weapon("Arming Sword", 20, 100, 1m, 0.25m);

            Archer archer = new Archer();
            archer.name = "Archer";
            archer.momentum = 0;
            archer.velocity = 7;
            archer.primary = new Weapon("Bow", 25, 150, 150m, 1.0m);
            archer.secondary = new Weapon("Arming Sword", 20, 100, 1m, 0.25m);
            archer.AddItem(new Item("Bandage", 20));

            Gunslinger gunslinger = new Gunslinger();
            gunslinger.name = "Gunslinger";
            gunslinger.momentum = 0;
            gunslinger.velocity = 10;
            gunslinger.primary = new Weapon("Musket", 50, 150, 100m, 2.5m);
            gunslinger.secondary = new Weapon("Rapier", 25, 100, 1.5m, 0.75m);

            Mage mage = new Mage();
            mage.name = "Mage";
            mage.momentum = 5;
            mage.velocity = 5;
            mage.primary = new Weapon("Quarterstaff", 20, 70, 1.8m, 0.9m);
            mage.secondary = new Weapon("Spells", 25, 25, 5m, 1.0m);

            Barbarian barbarian = new Barbarian();
            barbarian.name = "Barbarian";
            barbarian.momentum = 5;
            barbarian.velocity = 0;
            barbarian.primary = new Weapon("Axe", 25, 150, 0.75m, 0.95m);

            Bard bard = new Bard();
            bard.name = "Bard";
            bard.momentum = 0;
            bard.velocity = 0;
            bard.primary = new Weapon("Lute", 0, 0, 10m, 0m);
            bard.secondary = new Weapon("Short Spear", 30, 150, 2m, 0.5m);

            Builder builder = new Builder();
            builder.name = "Builder";
            builder.momentum = 3;
            builder.velocity = 0;
            builder.primary = new Weapon("War Hammer", 20, 150, 1.2m, 1.5m);
            builder.secondary = new Weapon("Construction Hammer", 0, 0, 0.3m, 0m);

            Medic medic = new Medic();
            medic.name = "Medic";
            medic.momentum = 0;
            medic.velocity = 0;
            medic.primary = new Weapon("Bonesaw", 20, 95, 1m, 0.75m);
            medic.secondary = new Weapon("Medical Supplies", 0, 0, 0.5m, 0m);

            Priest priest = new Priest();
            priest.name = "Priest";
            priest.momentum = 0;
            priest.velocity = 0;
            priest.primary = new Weapon("Crucifix", 0, 0, 10m, 6.5m);

            Console.WriteLine("<---- We Won't Balance Spears ----o");
            Console.WriteLine();
            Console.WriteLine("Select your class:");
            Console.WriteLine("1) Man-at-Arms");
            Console.WriteLine("2) Archer");
            Console.WriteLine("3) Gunslinger");
            Console.WriteLine("4) Mage");
            Console.WriteLine("5) Barbarian");
            Console.WriteLine("6) Bard");
            Console.WriteLine("7) Builder");
            Console.WriteLine("8) Medic");
            Console.WriteLine("9) Priest");
            Console.WriteLine("10) Craftsman");
            Console.WriteLine();
            Console.Write("Selection: ");

            if (!int.TryParse(Console.ReadLine(), out int selectedClass))
            {
                Console.WriteLine("Invalid selection.");
                return;
            }

            Unit? selectedUnit = null;

            switch (selectedClass)
            {
                case 1:
                    selectedUnit = manAtArms;
                    break;

                case 2:
                    selectedUnit = archer;
                    break;

                case 3:
                    selectedUnit = gunslinger;
                    break;

                case 4:
                    selectedUnit = mage;
                    break;

                case 5:
                    Console.WriteLine("Coming soon...");
                    return;

                default:
                    Console.WriteLine("Invalid selection.");
                    return;
            }

            Console.WriteLine();
            Console.WriteLine("You selected the " + selectedUnit.name + ".");
            Console.WriteLine("Primary: " + (selectedUnit.primary?.name ?? "None"));
            Console.WriteLine("Secondary: " + (selectedUnit.secondary?.name ?? "None"));
        }
    }
}
